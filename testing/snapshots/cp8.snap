#A _F _B _C _D _E _H _L __PC __SP|0123456789ABCDEF0123456789ABCDEF
# init
80 00 20 80 FF 40 0F 00 0010 0000 0000000000000000000000000000007F
# first cycle
80 00 20 80 FF 40 0F 00 0011 0000 0000000000000000000000000000007F
# CP B: 80 - 20 = 60
80 40 20 80 FF 40 0F 00 0012 0000 0000000000000000000000000000007F
# CP C: 80 - 80 = 00, zero set
80 C0 20 80 FF 40 0F 00 0013 0000 0000000000000000000000000000007F
# CP D: 80 - FF = 81, carry set, half-carry set
80 70 20 80 FF 40 0F 00 0014 0000 0000000000000000000000000000007F
# CP E: 80 - 40 = 40
80 40 20 80 FF 40 0F 00 0015 0000 0000000000000000000000000000007F
# CP H: 80 - 0F = 71, half-carry set
80 60 20 80 FF 40 0F 00 0016 0000 0000000000000000000000000000007F
# CP L: 80 - 00 = 80
80 40 20 80 FF 40 0F 00 0017 0000 0000000000000000000000000000007F
# CP A: 80 - 80 = 00, zero set
80 C0 20 80 FF 40 0F 00 0018 0000 0000000000000000000000000000007F
# LD HL, 000F
80 C0 20 80 FF 40 0F 00 0019 0000 0000000000000000000000000000007F
80 C0 20 80 FF 40 0F 00 001A 0000 0000000000000000000000000000007F
80 C0 20 80 FF 40 00 0F 001B 0000 0000000000000000000000000000007F
# CP [HL] cycle 1: read from memory
80 C0 20 80 FF 40 00 0F 001B 0000 0000000000000000000000000000007F
# CP [HL] cycle 2: 80 - 7F = 01, half-carry set
80 60 20 80 FF 40 00 0F 001C 0000 0000000000000000000000000000007F
# CP n8 cycle 1: read immediate
80 60 20 80 FF 40 00 0F 001D 0000 0000000000000000000000000000007F
# CP n8 cycle 2: 80 - 55 = 2B, half-carry set
80 60 20 80 FF 40 00 0F 001E 0000 0000000000000000000000000000007F
