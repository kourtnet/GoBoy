# init
FF 00 21 30 80 01 10 0F 0010 0000 000000000000000000000000000000BB
# first cycle
FF 00 21 30 80 01 10 0F 0011 0000 000000000000000000000000000000BB
# DEC B: 21 - 1 = 20
FF 40 20 30 80 01 10 0F 0012 0000 000000000000000000000000000000BB
# DEC C: 30 - 1 = 2F, half-borrow set
FF 60 20 2F 80 01 10 0F 0013 0000 000000000000000000000000000000BB
# DEC D: 80 - 1 = 7F, half-borrow set
FF 60 20 2F 7F 01 10 0F 0014 0000 000000000000000000000000000000BB
# DEC E: 01 - 1 = 00, zero set
FF C0 20 2F 7F 00 10 0F 0015 0000 000000000000000000000000000000BB
# DEC H: 10 - 1 = 0F, half-borrow set
FF 60 20 2F 7F 00 0F 0F 0016 0000 000000000000000000000000000000BB
# DEC L: 0F - 1 = 0E
FF 40 20 2F 7F 00 0F 0E 0017 0000 000000000000000000000000000000BB
# DEC A: FF - 1 = FE
FE 40 20 2F 7F 00 0F 0E 0018 0000 000000000000000000000000000000BB
# LD HL, 000F
FE 40 20 2F 7F 00 0F 0E 0019 0000 000000000000000000000000000000BB
FE 40 20 2F 7F 00 0F 0E 001A 0000 000000000000000000000000000000BB
FE 40 20 2F 7F 00 00 0F 001B 0000 000000000000000000000000000000BB
# DEC [HL] cycle 1: read from memory
FE 40 20 2F 7F 00 00 0F 001B 0000 000000000000000000000000000000BB
# DEC [HL] cycle 2: BB - 1 = BA, modify and write
FE 40 20 2F 7F 00 00 0F 001B 0000 000000000000000000000000000000BA
