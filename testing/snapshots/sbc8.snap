#A _F _B _C _D _E _H _L __PC __SP|0123456789ABCDEF0123456789ABCDEF
# init
70 00 10 20 50 FF 0F 00 0010 0000 000000000000000000000000000000FE
# first cycle
70 00 10 20 50 FF 0F 00 0011 0000 000000000000000000000000000000FE
# SBC B: 70 - 10 - 0 = 60
60 40 10 20 50 FF 0F 00 0012 0000 000000000000000000000000000000FE
# SBC C: 60 - 20 - 0 = 40
40 40 10 20 50 FF 0F 00 0013 0000 000000000000000000000000000000FE
# SBC D: 40 - 50 - 0 = F0, carry set
F0 50 10 20 50 FF 0F 00 0014 0000 000000000000000000000000000000FE
# SBC E: F0 - FF - 1 = F0, carry set, half-carry set
F0 70 10 20 50 FF 0F 00 0015 0000 000000000000000000000000000000FE
# SBC H: F0 - 0F - 1 = E0, carry clear
E0 60 10 20 50 FF 0F 00 0016 0000 000000000000000000000000000000FE
# SBC L: E0 - 00 - 0 = E0
E0 40 10 20 50 FF 0F 00 0017 0000 000000000000000000000000000000FE
# SBC A: E0 - E0 - 0 = 00, zero set
00 C0 10 20 50 FF 0F 00 0018 0000 000000000000000000000000000000FE
# LD HL, 000F
00 C0 10 20 50 FF 0F 00 0019 0000 000000000000000000000000000000FE
00 C0 10 20 50 FF 0F 00 001A 0000 000000000000000000000000000000FE
00 C0 10 20 50 FF 00 0F 001B 0000 000000000000000000000000000000FE
# SBC [HL] cycle 1: read from memory
#00 C0 10 20 50 FF 00 0F 001B 0000 000000000000000000000000000000FE
## SBC [HL] cycle 2: 00 - FE - 0 = 02, carry set
#02 70 10 20 50 FF 00 0F 001C 0000 000000000000000000000000000000FE
# SBC n8 cycle 1: read immediate
#02 70 10 20 50 FF 00 0F 001D 0000 000000000000000000000000000000FE
## SBC n8 cycle 2: 02 - 33 - 1 = CE, carry set
#CE 70 10 20 50 FF 00 0F 001E 0000 000000000000000000000000000000FE
