#A _F _B _C _D _E _H _L __PC __SP|0123456789ABCDEF0123456789ABCDEF
# init: A=80, B=01, C=FF, D=40, E=FF, H=5F, L=00, PC=0010, SP=0000
80 00 01 FF 40 FF 5F 00 0010 0000 000000000000000000000000000000D8
# first cycle
80 00 01 FF 40 FF 5F 00 0011 0000 000000000000000000000000000000D8
# SUB B: 80 - 01 = 7F, flags: N=1 H=1
7F 60 01 FF 40 FF 5F 00 0012 0000 000000000000000000000000000000D8
# SUB C: 7F - FF = 80, flags: N=1 C=1
80 50 01 FF 40 FF 5F 00 0013 0000 000000000000000000000000000000D8
# SUB D: 80 - 40 = 40, flags: N=1
40 40 01 FF 40 FF 5F 00 0014 0000 000000000000000000000000000000D8
# SUB E: 40 - FF = 41, flags: N=1 H=1 C=1
41 70 01 FF 40 FF 5F 00 0015 0000 000000000000000000000000000000D8
# SUB H: 41 - 5F = E2, flags: N=1 H=1 C=1
E2 70 01 FF 40 FF 5F 00 0016 0000 000000000000000000000000000000D8
# SUB L: E2 - 00 = E2, flags: N=1
E2 40 01 FF 40 FF 5F 00 0017 0000 000000000000000000000000000000D8
# SUB A: E2 - E2 = 00, flags: Z=1 N=1
00 C0 01 FF 40 FF 5F 00 0018 0000 000000000000000000000000000000D8
# LD HL, 000F
00 C0 01 FF 40 FF 5F 00 0019 0000 000000000000000000000000000000D8
00 C0 01 FF 40 FF 5F 00 001A 0000 000000000000000000000000000000D8
00 C0 01 FF 40 FF 00 0F 001B 0000 000000000000000000000000000000D8
# SUB [HL]
00 C0 01 FF 40 FF 00 0F 001B 0000 000000000000000000000000000000D8
28 70 01 FF 40 FF 00 0F 001C 0000 000000000000000000000000000000D8
# SUB n8 (0x42): 28 - 42 = E6, flags: N=1 C=1
28 70 01 FF 40 FF 00 0F 001D 0000 000000000000000000000000000000D8
E6 50 01 FF 40 FF 00 0F 001E 0000 000000000000000000000000000000D8
